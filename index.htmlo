<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#090b0f">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Workout V3">
<title>Workout Tracker V3</title>

<style>
:root{
  --bg:#090b0f;
  --surface:#11151b;
  --surface2:#181d25;
  --surface3:#202630;
  --border:#282f39;
  --text:#f5f7fa;
  --muted:#89919d;
  --soft:#b8bec7;
  --accent:#ffffff;
  --good:#69e39a;
  --bad:#ff7474;
  --gold:#ffd76a;
  --radius:18px;
  --nav:78px;
}

*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}

html{background:var(--bg)}

body{
  margin:0;
  background:
    radial-gradient(circle at 50% -10%,#1b222d 0,transparent 35%),
    var(--bg);
  color:var(--text);
  font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","Segoe UI",sans-serif;
  min-height:100vh;
}

button,input,select{font:inherit}

button{
  border:0;
  cursor:pointer;
}

.app{
  width:100%;
  max-width:650px;
  margin:auto;
  min-height:100vh;
  padding-bottom:calc(var(--nav) + 20px);
}

header{
  padding:calc(25px + env(safe-area-inset-top)) 20px 10px;
}

.header-row{
  display:flex;
  align-items:center;
  justify-content:space-between;
}

h1{
  font-size:31px;
  line-height:1;
  margin:0;
  letter-spacing:-1px;
}

h2{margin:0;font-size:25px}
h3{margin:0;font-size:18px}
p{margin:7px 0}

.muted{color:var(--muted)}
.soft{color:var(--soft)}
.small{font-size:12px}

.screen{
  display:none;
  padding:12px 17px;
  animation:screenIn .28s ease;
}

.screen.active{display:block}

@keyframes screenIn{
  from{opacity:0;transform:translateY(8px)}
  to{opacity:1;transform:none}
}

.card{
  background:linear-gradient(145deg,var(--surface),#0f1318);
  border:1px solid var(--border);
  border-radius:var(--radius);
  padding:17px;
  margin-bottom:13px;
  box-shadow:0 8px 25px rgba(0,0,0,.12);
}

.card.pop{
  animation:pop .35s ease;
}

@keyframes pop{
  0%{transform:scale(.97);opacity:.5}
  100%{transform:scale(1);opacity:1}
}

.hero{
  min-height:175px;
  display:flex;
  flex-direction:column;
  justify-content:flex-end;
  overflow:hidden;
  position:relative;
}

.hero:before{
  content:"";
  position:absolute;
  width:190px;
  height:190px;
  border-radius:50%;
  background:rgba(255,255,255,.035);
  right:-70px;
  top:-75px;
}

.hero-number{
  font-size:54px;
  font-weight:850;
  letter-spacing:-3px;
  position:relative;
}

.hero-title{
  font-size:14px;
  color:var(--muted);
  position:relative;
}

.grid2{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:11px;
}

.grid3{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:9px;
}

.stat{
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:16px;
  padding:15px;
}

.stat-value{
  font-size:23px;
  font-weight:800;
  margin-top:5px;
}

.progress-bar{
  width:100%;
  height:7px;
  background:#252b34;
  border-radius:20px;
  overflow:hidden;
  margin:12px 0;
}

.progress-fill{
  height:100%;
  width:0;
  background:#f3f3f3;
  border-radius:20px;
  transition:width .45s cubic-bezier(.2,.8,.2,1);
}

.primary{
  width:100%;
  background:#f2f2f2;
  color:#080a0d;
  padding:14px;
  border-radius:14px;
  font-weight:800;
  transition:transform .12s,opacity .12s;
}

.primary:active{transform:scale(.97);opacity:.8}

.secondary{
  background:var(--surface3);
  color:var(--text);
  padding:11px 13px;
  border-radius:12px;
  font-weight:650;
  transition:transform .12s;
}

.secondary:active{transform:scale(.96)}

.danger{
  background:#3a2024;
  color:#ff969d;
  padding:10px 12px;
  border-radius:11px;
}

.good{
  color:var(--good);
}

.gold{
  color:var(--gold);
}

.section-title{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin:21px 3px 10px;
}

.day-card{
  position:relative;
  overflow:hidden;
  transition:transform .2s;
}

.day-card:active{transform:scale(.985)}

.day-card .day{
  color:var(--muted);
  font-size:12px;
  margin-bottom:6px;
}

.day-card .name{
  font-size:19px;
  font-weight:800;
}

.day-card.today{
  border-color:#565e69;
}

.today-label{
  position:absolute;
  right:14px;
  top:14px;
  font-size:11px;
  background:#252b33;
  padding:5px 8px;
  border-radius:8px;
}

.nav{
  position:fixed;
  z-index:50;
  bottom:0;
  left:50%;
  transform:translateX(-50%);
  width:min(650px,100%);
  height:calc(var(--nav) + env(safe-area-inset-bottom));
  padding-bottom:env(safe-area-inset-bottom);
  background:rgba(11,14,18,.95);
  backdrop-filter:blur(20px);
  -webkit-backdrop-filter:blur(20px);
  border-top:1px solid var(--border);
  display:flex;
  justify-content:space-around;
}

.nav button{
  flex:1;
  background:none;
  color:#69717d;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:4px;
  font-size:10px;
  transition:color .2s;
}

.nav button.active{color:white}

.nav-icon{
  font-size:20px;
  height:23px;
}

.back-row{
  display:flex;
  align-items:center;
  gap:12px;
  margin-bottom:17px;
}

.back{
  background:var(--surface3);
  color:white;
  border-radius:11px;
  padding:9px 12px;
}

.workout-heading{
  font-size:24px;
  font-weight:850;
}

.exercise-card{
  padding:15px;
  position:relative;
}

.exercise-top{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:10px;
}

.exercise-name{
  font-size:18px;
  font-weight:800;
}

.exercise-sub{
  color:var(--muted);
  font-size:12px;
  margin-top:3px;
}

.pr-badge{
  background:rgba(255,215,106,.12);
  color:var(--gold);
  border:1px solid rgba(255,215,106,.2);
  border-radius:9px;
  padding:5px 8px;
  font-size:10px;
  font-weight:800;
  white-space:nowrap;
}

.previous{
  margin:12px 0 10px;
  padding:10px;
  background:#1a1f26;
  border-radius:11px;
  font-size:12px;
}

.previous strong{color:white}

.set-head,.set-row{
  display:grid;
  grid-template-columns:30px 1fr 1fr 1fr 35px;
  gap:6px;
  align-items:center;
}

.set-head{
  color:#707884;
  font-size:9px;
  margin:9px 0 5px;
}

.set-row{
  margin-bottom:6px;
  animation:setIn .2s ease;
}

@keyframes setIn{
  from{opacity:0;transform:translateX(-8px)}
  to{opacity:1;transform:none}
}

.set-number{
  color:#727a86;
  text-align:center;
  font-size:12px;
}

input,select{
  width:100%;
  background:#0b0e12;
  color:white;
  border:1px solid #2a3039;
  border-radius:10px;
  padding:11px 8px;
  outline:none;
}

input:focus,select:focus{
  border-color:#646c78;
}

.check{
  height:42px;
  border-radius:10px;
  background:#242a32;
  color:#858d98;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:17px;
}

.check.done{
  background:#173224;
  color:var(--good);
}

.remove-set{
  height:42px;
  border-radius:10px;
  background:#242a32;
  color:#9aa1ab;
}

.exercise-actions{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:7px;
  margin-top:10px;
}

.rir{
  margin-top:9px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
}

.rir select{
  width:110px;
  padding:8px;
}

.complete-box{
  position:sticky;
  bottom:85px;
  z-index:10;
  padding-top:10px;
  background:linear-gradient(transparent,var(--bg) 25%);
}

.timer-card{
  text-align:center;
  padding:22px 15px;
}

.timer-circle{
  width:145px;
  height:145px;
  margin:10px auto 16px;
  border-radius:50%;
  border:5px solid #292f38;
  display:flex;
  align-items:center;
  justify-content:center;
  position:relative;
}

.timer-circle.running{
  animation:pulse 1s infinite alternate;
}

@keyframes pulse{
  from{box-shadow:0 0 0 rgba(255,255,255,0)}
  to{box-shadow:0 0 25px rgba(255,255,255,.08)}
}

.timer-number{
  font-size:42px;
  font-weight:850;
  letter-spacing:-2px;
}

.timer-buttons{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:7px;
}

.chart-wrap{
  position:relative;
  width:100%;
  height:220px;
  background:#0d1015;
  border-radius:14px;
  overflow:hidden;
  margin-top:13px;
}

canvas{
  width:100%;
  height:100%;
}

.select-label{
  font-size:11px;
  color:var(--muted);
  margin-bottom:6px;
}

.pr-row{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:12px 0;
  border-bottom:1px solid #252a32;
}

.pr-row:last-child{border-bottom:0}

.pr-name{
  font-weight:700;
}

.pr-value{
  text-align:right;
  color:var(--gold);
  font-weight:800;
}

.history-row{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
}

.history-main{
  min-width:0;
}

.history-name{
  font-weight:800;
}

.history-date{
  color:var(--muted);
  font-size:12px;
  margin-top:3px;
}

.modal{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.7);
  backdrop-filter:blur(10px);
  z-index:100;
  display:none;
  align-items:flex-end;
}

.modal.show{display:flex}

.modal-box{
  width:100%;
  max-width:650px;
  margin:auto;
  background:#13171d;
  border:1px solid var(--border);
  border-radius:24px 24px 0 0;
  padding:20px;
  animation:modalIn .25s ease;
}

@keyframes modalIn{
  from{transform:translateY(100%)}
  to{transform:none}
}

.toast{
  position:fixed;
  z-index:200;
  left:50%;
  bottom:95px;
  transform:translate(-50%,20px);
  background:#f0f0f0;
  color:#090a0c;
  padding:11px 15px;
  border-radius:12px;
  font-weight:700;
  font-size:13px;
  opacity:0;
  pointer-events:none;
  transition:.25s;
}

.toast.show{
  opacity:1;
  transform:translate(-50%,0);
}

.empty{
  text-align:center;
  padding:35px 10px;
  color:var(--muted);
}

.big-pr{
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.pr-number{
  font-size:29px;
  font-weight:850;
  color:var(--gold);
}

.progress-positive{
  color:var(--good);
  font-size:12px;
  font-weight:700;
}

.progress-negative{
  color:var(--bad);
  font-size:12px;
}

.settings-row{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:10px;
  padding:12px 0;
  border-bottom:1px solid #252a32;
}

.settings-row:last-child{border-bottom:0}

@media(max-width:370px){
  .set-head,.set-row{
    grid-template-columns:25px 1fr 1fr 1fr 31px;
    gap:4px;
  }

  .set-row input{
    padding:10px 5px;
  }
}
</style>
</head>

<body>

<div class="app">

<header>
  <div class="header-row">
    <div>
      <h1 id="headerTitle">Dashboard</h1>
      <div class="muted small" id="headerSubtitle">Train. Track. Progress.</div>
    </div>
    <div id="headerIcon">🏋️</div>
  </div>
</header>

<!-- DASHBOARD -->
<section id="dashboard" class="screen active">

  <div class="card hero">
    <div class="hero-title">CURRENT STREAK</div>
    <div class="hero-number"><span id="dashStreak">0</span> 🔥</div>
    <div class="muted">Consistency beats perfection.</div>
  </div>

  <div class="grid3">
    <div class="stat">
      <div class="muted small">Sessions</div>
      <div class="stat-value" id="dashSessions">0</div>
    </div>
    <div class="stat">
      <div class="muted small">Volume</div>
      <div class="stat-value" id="dashVolume">0</div>
    </div>
    <div class="stat">
      <div class="muted small">PRs</div>
      <div class="stat-value" id="dashPRs">0</div>
    </div>
  </div>

  <div class="section-title">
    <h3>Today's plan</h3>
  </div>

  <div class="card" id="todayCard"></div>

  <div class="section-title">
    <h3>This week</h3>
  </div>

  <div id="weekList"></div>

  <div class="section-title">
    <h3>Recent achievement</h3>
  </div>

  <div class="card" id="recentAchievement"></div>

</section>

<!-- WORKOUTS -->
<section id="workouts" class="screen">

  <div class="section-title">
    <h2>Workouts</h2>
  </div>

  <div id="workoutList"></div>

</section>

<!-- PROGRESS -->
<section id="progress" class="screen">

  <div class="section-title">
    <h2>Progress</h2>
  </div>

  <div class="card">
    <div class="select-label">TRACK EXERCISE</div>
    <select id="progressSelect"></select>

    <div class="chart-wrap">
      <canvas id="progressCanvas"></canvas>
    </div>
  </div>

  <div id="progressSummary"></div>

  <div class="section-title">
    <h3>Personal records</h3>
  </div>

  <div class="card" id="prList"></div>

</section>

<!-- HISTORY -->
<section id="history" class="screen">

  <div class="section-title">
    <h2>History</h2>
  </div>

  <div class="grid2">
    <div class="stat">
      <div class="muted small">Sessions</div>
      <div class="stat-value" id="historySessions">0</div>
    </div>
    <div class="stat">
      <div class="muted small">Total sets</div>
      <div class="stat-value" id="historySets">0</div>
    </div>
  </div>

  <div style="height:10px"></div>

  <div id="historyList"></div>

</section>

<!-- SETTINGS -->
<section id="settings" class="screen">

  <div class="section-title">
    <h2>Settings</h2>
  </div>

  <div class="card">
    <h3>Exercises</h3>
    <p class="muted small">Add or remove exercises from your routines.</p>
  </div>

  <div id="exerciseManager"></div>

  <div class="card">
    <h3>Add exercise</h3>

    <div style="height:10px"></div>

    <select id="addWorkoutSelect"></select>

    <div style="height:9px"></div>

    <input id="addExerciseInput" placeholder="Exercise name">

    <button class="primary" style="margin-top:10px" onclick="addExercise()">
      + Add Exercise
    </button>
  </div>

  <div class="card">
    <h3>Data</h3>

    <button class="secondary" style="width:100%;margin-top:10px" onclick="exportBackup()">
      Export Backup
    </button>

    <label class="secondary" style="display:block;text-align:center;margin-top:8px">
      Import Backup
      <input id="importFile" type="file" accept=".json" style="display:none" onchange="importBackup(event)">
    </label>

    <button class="danger" style="width:100%;margin-top:8px" onclick="resetAll()">
      Reset All Data
    </button>
  </div>

  <div class="card">
    <div class="settings-row">
      <span>Version</span>
      <span class="muted">V3.0</span>
    </div>
    <div class="settings-row">
      <span>Storage</span>
      <span class="good">Local</span>
    </div>
  </div>

</section>

<!-- ACTIVE WORKOUT -->
<section id="activeWorkout" class="screen">

  <div class="back-row">
    <button class="back" onclick="exitWorkout()">←</button>
    <div>
      <div class="workout-heading" id="activeWorkoutName">Workout</div>
      <div class="muted small" id="activeWorkoutMeta"></div>
    </div>
  </div>

  <div class="progress-bar">
    <div class="progress-fill" id="activeProgress"></div>
  </div>

  <div class="muted small" id="activeProgressText">0% complete</div>

  <div style="height:12px"></div>

  <div id="activeExercises"></div>

  <div class="card timer-card">

    <h3>Rest Timer</h3>

    <div class="timer-circle" id="timerCircle">
      <div class="timer-number" id="timerNumber">90</div>
    </div>

    <div class="timer-buttons">
      <button class="secondary" onclick="startTimer(60)">60s</button>
      <button class="secondary" onclick="startTimer(90)">90s</button>
      <button class="secondary" onclick="startTimer(120)">120s</button>
    </div>

    <button class="secondary" style="width:100%;margin-top:8px" onclick="stopTimer()">
      Stop
    </button>

  </div>

  <div class="complete-box">
    <button class="primary" onclick="completeWorkout()">
      Complete Workout ✓
    </button>
  </div>

</section>

<!-- NAV -->
<nav class="nav">

  <button data-nav="dashboard" class="active" onclick="showScreen('dashboard')">
    <span class="nav-icon">⌂</span>
    Home
  </button>

  <button data-nav="workouts" onclick="showScreen('workouts')">
    <span class="nav-icon">💪</span>
    Train
  </button>

  <button data-nav="progress" onclick="showScreen('progress')">
    <span class="nav-icon">↗</span>
    Progress
  </button>

  <button data-nav="history" onclick="showScreen('history')">
    <span class="nav-icon">▣</span>
    History
  </button>

  <button data-nav="settings" onclick="showScreen('settings')">
    <span class="nav-icon">⚙</span>
    Settings
  </button>

</nav>

</div>

<div class="toast" id="toast"></div>

<script>

/* =========================================================
   WORKOUT TRACKER V3
   ========================================================= */

const DEFAULT_WORKOUTS = {

  "Arms + Shoulders":[
    "Leon Kahara Presses",
    "Preacher Curl",
    "Cable Lateral Raises",
    "Incline Seated Curl",
    "Rear Delt Flys",
    "Tricep Overhead Extension",
    "Sullen Curls"
  ],

  "Chest + Back":[
    "Wide Grip Seated Row",
    "Incline Chest Press",
    "Close Grip Row",
    "Leg Dec",
    "Lat Pulldown"
  ],

  "Legs":[
    "Leg Press",
    "Leg Extension",
    "Leg Curl",
    "Calf Raises"
  ]
};

const SPLIT = {
  0:"Chest + Back",
  1:null,
  2:"Arms + Shoulders",
  3:null,
  4:"Chest + Back",
  5:"Arms + Shoulders",
  6:"Legs"
};

let state = loadState();

let timerInterval = null;
let timerRemaining = 90;

function freshState(){

  return {
    workouts:JSON.parse(JSON.stringify(DEFAULT_WORKOUTS)),
    history:[],
    current:null
  };
}

function loadState(){

  try{

    const saved =
      localStorage.getItem("WORKOUT_TRACKER_V3");

    if(saved){

      const parsed=JSON.parse(saved);

      return {
        workouts:parsed.workouts || JSON.parse(JSON.stringify(DEFAULT_WORKOUTS)),
        history:parsed.history || [],
        current:parsed.current || null
      };
    }

  }catch(e){}

  return freshState();
}

function save(){

  localStorage.setItem(
    "WORKOUT_TRACKER_V3",
    JSON.stringify(state)
  );
}

function todayWorkout(){

  return SPLIT[new Date().getDay()];
}

function dateKey(date){

  return new Date(date).toLocaleDateString(
    "en-AU",
    {
      day:"2-digit",
      month:"2-digit",
      year:"numeric"
    }
  );
}

function formatDate(date){

  return new Date(date).toLocaleDateString(
    "en-AU",
    {
      weekday:"short",
      day:"numeric",
      month:"short"
    }
  );
}

function showToast(message){

  const toast=document.getElementById("toast");

  toast.textContent=message;
  toast.classList.add("show");

  setTimeout(
    ()=>toast.classList.remove("show"),
    1800
  );
}

function showScreen(id){

  if(state.current && id!=="activeWorkout"){
    /* don't destroy active workout */
  }

  document.querySelectorAll(".screen")
    .forEach(s=>s.classList.remove("active"));

  const screen=document.getElementById(id);

  if(screen) screen.classList.add("active");

  document.querySelectorAll(".nav button")
    .forEach(b=>b.classList.remove("active"));

  const nav=document.querySelector(
    `[data-nav="${id}"]`
  );

  if(nav) nav.classList.add("active");

  const titles={
    dashboard:["Dashboard","Train. Track. Progress.","🏋️"],
    workouts:["Workouts","Choose your session.","💪"],
    progress:["Progress","See how you're improving.","↗"],
    history:["History","Your training history.","▣"],
    settings:["Settings","Customise your tracker.","⚙"],
    activeWorkout:["Training","Session in progress.","🔥"]
  };

  const t=titles[id]||titles.dashboard;

  document.getElementById("headerTitle").textContent=t[0];
  document.getElementById("headerSubtitle").textContent=t[1];
  document.getElementById("headerIcon").textContent=t[2];

  if(id==="dashboard") renderDashboard();
  if(id==="workouts") renderWorkouts();
  if(id==="progress") renderProgress();
  if(id==="history") renderHistory();
  if(id==="settings") renderSettings();
  if(id==="activeWorkout") renderActiveWorkout();
}

/* =========================================================
   DASHBOARD
   ========================================================= */

function calculateVolume(){

  let total=0;

  state.history.forEach(workout=>{

    workout.exercises.forEach(ex=>{

      ex.sets.forEach(set=>{

        const weight=Number(set.weight);
        const reps=Number(set.reps);

        if(weight>0 && reps>0)
          total+=weight*reps;

      });

    });

  });

  return total;
}

function calculateTotalSets(){

  let total=0;

  state.history.forEach(workout=>{

    workout.exercises.forEach(ex=>{

      ex.sets.forEach(set=>{

        if(
          set.weight!=="" &&
          set.reps!==""
        ) total++;

      });

    });

  });

  return total;
}

function calculateStreak(){

  if(!state.history.length) return 0;

  const worked=new Set(
    state.history.map(w=>dateKey(w.date))
  );

  let streak=0;
  let d=new Date();

  while(true){

    if(worked.has(dateKey(d))){

      streak++;
      d.setDate(d.getDate()-1);

    }else{

      break;

    }

  }

  return streak;
}

function allPRs(){

  const prs={};

  state.history.forEach(workout=>{

    workout.exercises.forEach(ex=>{

      ex.sets.forEach(set=>{

        const w=Number(set.weight);
        const r=Number(set.reps);

        if(!w || !r) return;

        const estimated =
          w*(1+r/30);

        if(!prs[ex.name]){

          prs[ex.name]={
            weight:w,
            reps:r,
            e1rm:estimated
          };

        }else{

          prs[ex.name].weight=
            Math.max(prs[ex.name].weight,w);

          prs[ex.name].reps=
            Math.max(prs[ex.name].reps,r);

          prs[ex.name].e1rm=
            Math.max(prs[ex.name].e1rm,estimated);

        }

      });

    });

  });

  return prs;
}

function renderDashboard(){

  const prs=allPRs();

  document.getElementById("dashStreak")
    .textContent=calculateStreak();

  document.getElementById("dashSessions")
    .textContent=state.history.length;

  const volume=calculateVolume();

  document.getElementById("dashVolume")
    .textContent=
      volume>=1000
      ?(volume/1000).toFixed(1)+"k"
      :Math.round(volume);

  document.getElementById("dashPRs")
    .textContent=Object.keys(prs).length;

  const today=todayWorkout();

  const todayCard=document.getElementById("todayCard");

  if(today){

    todayCard.innerHTML=`

      <div class="muted small">TODAY</div>

      <h2 style="margin-top:5px">${escapeHTML(today)}</h2>

      <p class="muted">
        ${state.workouts[today].length} exercises
      </p>

      <button class="primary"
        style="margin-top:8px"
        onclick="startWorkout('${escapeAttr(today)}')">
        Start Today's Workout
      </button>

    `;

  }else{

    todayCard.innerHTML=`

      <div class="muted small">TODAY</div>

      <h2 style="margin-top:5px">Rest Day</h2>

      <p class="muted">
        Recovery is part of training.
      </p>

      <button class="secondary"
        style="width:100%;margin-top:8px"
        onclick="showScreen('workouts')">
        Choose Another Workout
      </button>

    `;

  }

  renderWeek();

  const achievement=
    state.history[state.history.length-1];

  const recent=
    document.getElementById("recentAchievement");

  if(!achievement){

    recent.innerHTML=`
      <div class="empty">
        Complete your first workout to start
        building your progress history.
      </div>
    `;

  }else{

    recent.innerHTML=`

      <div class="big-pr">

        <div>
          <div class="muted small">
            LAST SESSION
          </div>

          <h3 style="margin-top:5px">
            ${escapeHTML(achievement.name)}
          </h3>

          <div class="muted small">
            ${formatDate(achievement.date)}
          </div>
        </div>

        <div class="pr-number">
          ${calculateWorkoutVolume(achievement)}
        </div>

      </div>

      <div class="muted small" style="margin-top:10px">
        kg total volume
      </div>

    `;

  }
}

function renderWeek(){

  const container=document.getElementById("weekList");

  container.innerHTML="";

  const names=[
    "Sunday",
    "Monday",
    "Tuesday",
    "Wednesday",
    "Thursday",
    "Friday",
    "Saturday"
  ];

  const today=new Date().getDay();

  for(let i=1;i<=7;i++){

    const day=(today+i-1)%7;

    const workout=SPLIT[day];

    const card=document.createElement("div");

    card.className=
      "card day-card"+
      (day===today?" today":"");

    card.innerHTML=`

      ${day===today?'<div class="today-label">TODAY</div>':""}

      <div class="day">${names[day]}</div>

      <div class="name">
        ${workout || "Rest"}
      </div>

      <div class="muted small" style="margin-top:4px">
        ${
          workout
          ? state.workouts[workout].length+" exercises"
          : "Recovery"
        }
      </div>

    `;

    if(workout){

      card.onclick=
        ()=>startWorkout(workout);

    }

    container.appendChild(card);

  }
}

function calculateWorkoutVolume(workout){

  let total=0;

  workout.exercises.forEach(ex=>{

    ex.sets.forEach(set=>{

      const w=Number(set.weight);
      const r=Number(set.reps);

      if(w&&r) total+=w*r;

    });

  });

  return Math.round(total).toLocaleString();
}

/* =========================================================
   WORKOUT LIST
   ========================================================= */

function renderWorkouts(){

  const container=document.getElementById("workoutList");

  container.innerHTML="";

  Object.entries(state.workouts)
    .forEach(([name,exercises])=>{

      const card=document.createElement("div");

      card.className="card day-card";

      card.innerHTML=`

        <div class="muted small">
          WORKOUT
        </div>

        <div class="name" style="margin-top:5px">
          ${escapeHTML(name)}
        </div>

        <div class="muted small" style="margin-top:5px">
          ${exercises.length} exercises
        </div>

        <button class="primary"
          style="margin-top:13px"
          onclick="startWorkout('${escapeAttr(name)}')">
          Start Workout
        </button>

      `;

      container.appendChild(card);

    });

}

/* =========================================================
   START WORKOUT
   ========================================================= */

function startWorkout(name){

  if(!state.workouts[name]) return;

  const exercises=
    state.workouts[name].map(exercise=>({

      name:exercise,

      sets:[
        createEmptySet(),
        createEmptySet()
      ],

      rir:"0"

    }));

  state.current={
    id:Date.now(),
    name,
    started:new Date().toISOString(),
    exercises
  };

  save();

  showScreen("activeWorkout");

  showToast("Workout started 💪");
}

function createEmptySet(){

  return{
    weight:"",
    reps:"",
    rir:"0"
  };
}

function renderActiveWorkout(){

  if(!state.current) return;

  document.getElementById("activeWorkoutName")
    .textContent=state.current.name;

  document.getElementById("activeWorkoutMeta")
    .textContent=
      state.current.exercises.length+
      " exercises • 2 sets to start";

  const container=
    document.getElementById("activeExercises");

  container.innerHTML="";

  state.current.exercises.forEach(
    (exercise,index)=>{

      const card=document.createElement("div");

      card.className="card exercise-card";

      const previous=getPreviousPerformance(
        exercise.name
      );

      const pr=getExercisePR(
        exercise.name
      );

      let sets="";

      exercise.sets.forEach(
        (set,setIndex)=>{

          const done=
            set.weight!=="" &&
            set.reps!=="";

          sets+=`

            <div class="set-row">

              <div class="set-number">
                ${setIndex+1}
              </div>

              <input
                type="number"
                inputmode="decimal"
                placeholder="kg"
                value="${set.weight}"
                onchange="updateSet(${index},${setIndex},'weight',this.value)"
              >

              <input
                type="number"
                inputmode="numeric"
                placeholder="reps"
                value="${set.reps}"
                onchange="updateSet(${index},${setIndex},'reps',this.value)"
              >

              <button
                class="check ${done?"done":""}"
                onclick="toggleSetDone(${index},${setIndex})">
                ${done?"✓":"○"}
              </button>

              <button
                class="remove-set"
                onclick="removeSet(${index},${setIndex})">
                ×
              </button>

            </div>

          `;

        }
      );

      card.innerHTML=`

        <div class="exercise-top">

          <div>

            <div class="exercise-name">
              ${escapeHTML(exercise.name)}
            </div>

            <div class="exercise-sub">
              ${pr ? "Best: "+pr.weight+"kg × "+pr.reps : "No PR yet"}
            </div>

          </div>

          ${
            pr
            ? `<div class="pr-badge">PR ${pr.weight}kg</div>`
            : ""
          }

        </div>

        ${
          previous
          ?
          `<div class="previous">
            Last time:
            <strong>
              ${previous.text}
            </strong>
            <span class="muted">
              • ${previous.date}
            </span>
          </div>`
          :
          `<div class="previous muted">
            No previous performance — first entry.
          </div>`
        }

        <div class="set-head">
          <div>#</div>
          <div>WEIGHT</div>
          <div>REPS</div>
          <div>DONE</div>
          <div></div>
        </div>

        ${sets}

        <div class="rir">

          <span class="muted small">
            RIR — reps in reserve
          </span>

          <select onchange="updateExerciseRIR(${index},this.value)">

            <option value="0" ${exercise.rir==="0"?"selected":""}>
              Failure / 0
            </option>

            <option value="1" ${exercise.rir==="1"?"selected":""}>
              1 RIR
            </option>

            <option value="2" ${exercise.rir==="2"?"selected":""}>
              2 RIR
            </option>

            <option value="3" ${exercise.rir==="3"?"selected":""}>
              3 RIR
            </option>

          </select>

        </div>

        <div class="exercise-actions">

          <button class="secondary"
            onclick="addSet(${index})">
            + Add Set
          </button>

          <button class="secondary"
            onclick="startTimer(90)">
            Rest 90s
          </button>

        </div>

      `;

      container.appendChild(card);

    }
  );

  updateActiveProgress();

}

function updateSet(
  exerciseIndex,
  setIndex,
  field,
  value
){

  state.current.exercises[
    exerciseIndex
  ].sets[setIndex][field]=value;

  save();

  updateActiveProgress();

}

function toggleSetDone(
  exerciseIndex,
  setIndex
){

  const set=
    state.current.exercises[
      exerciseIndex
    ].sets[setIndex];

  if(
    set.weight!=="" &&
    set.reps!==""
  ){

    set.weight="";
    set.reps="";

  }

  save();

  renderActiveWorkout();

}

function addSet(index){

  state.current.exercises[index]
    .sets.push(createEmptySet());

  save();

  renderActiveWorkout();

}

function removeSet(
  exerciseIndex,
  setIndex
){

  const sets=
    state.current.exercises[
      exerciseIndex
    ].sets;

  if(sets.length<=1){

    showToast("Keep at least one set.");

    return;

  }

  sets.splice(setIndex,1);

  save();

  renderActiveWorkout();

}

function updateExerciseRIR(index,value){

  state.current.exercises[index].rir=value;

  save();

}

function updateActiveProgress(){

  if(!state.current) return;

  let total=0;
  let done=0;

  state.current.exercises.forEach(ex=>{

    ex.sets.forEach(set=>{

      total++;

      if(
        set.weight!=="" &&
        set.reps!==""
      ) done++;

    });

  });

  const percent=
    total
    ? Math.round(done/total*100)
    :0;

  document.getElementById("activeProgress")
    .style.width=percent+"%";

  document.getElementById("activeProgressText")
    .textContent=
      percent+"% complete • "+
      done+"/"+total+" sets";

}

/* =========================================================
   PREVIOUS PERFORMANCE
   ========================================================= */

function getPreviousPerformance(exerciseName){

  for(
    let i=state.history.length-1;
    i>=0;
    i--
  ){

    const workout=state.history[i];

    const exercise=
      workout.exercises.find(
        e=>e.name===exerciseName
      );

    if(!exercise) continue;

    const valid=
      exercise.sets.filter(
        s=>s.weight!==""&&s.reps!==""
      );

    if(!valid.length) continue;

    const best=
      [...valid].sort(
        (a,b)=>
          Number(b.weight)-Number(a.weight)
      )[0];

    return{
      weight:best.weight,
      reps:best.reps,
      text:best.weight+"kg × "+best.reps,
      date:formatDate(workout.date)
    };

  }

  return null;
}

/* =========================================================
   PR + PROGRESSION ENGINE
   ========================================================= */

function getExercisePR(exerciseName){

  let best=null;

  state.history.forEach(workout=>{

    workout.exercises.forEach(ex=>{

      if(ex.name!==exerciseName) return;

      ex.sets.forEach(set=>{

        const weight=Number(set.weight);
        const reps=Number(set.reps);

        if(!weight||!reps) return;

        const e1rm=
          weight*(1+reps/30);

        if(
          !best ||
          weight>best.weight
        ){

          best={
            weight,
            reps,
            e1rm
          };

        }

      });

    });

  });

  return best;

}

function getProgressData(exerciseName){

  const points=[];

  state.history.forEach(workout=>{

    const exercise=
      workout.exercises.find(
        e=>e.name===exerciseName
      );

    if(!exercise) return;

    const valid=
      exercise.sets.filter(
        s=>s.weight!==""&&s.reps!==""
      );

    if(!valid.length) return;

    const best=
      Math.max(
        ...valid.map(
          s=>Number(s.weight)
        )
      );

    const bestSet=
      valid.find(
        s=>Number(s.weight)===best
      );

    const e1rm=
      Number(bestSet.weight)*
      (1+Number(bestSet.reps)/30);

    points.push({
      date:workout.date,
      weight:best,
      reps:Number(bestSet.reps),
      e1rm
    });

  });

  return points;

}

/* =========================================================
   PROGRESS PAGE
   ========================================================= */

function renderProgress(){

  const select=
    document.getElementById("progressSelect");

  const exercises=allExercises();

  const previous=select.value;

  select.innerHTML="";

  exercises.forEach(ex=>{

    const option=
      document.createElement("option");

    option.value=ex;
    option.textContent=ex;

    select.appendChild(option);

  });

  if(
    previous &&
    exercises.includes(previous)
  ){
    select.value=previous;
  }

  select.onchange=drawProgress;

  drawProgress();

  renderPRList();

}

function drawProgress(){

  const select=
    document.getElementById("progressSelect");

  if(!select.value) return;

  const data=
    getProgressData(select.value);

  drawChart(data);

  const summary=
    document.getElementById("progressSummary");

  if(!data.length){

    summary.innerHTML=`

      <div class="card empty">
        Log this exercise during a workout
        to start seeing progression.
      </div>

    `;

    return;

  }

  const first=data[0];
  const last=data[data.length-1];

  const change=
    last.weight-first.weight;

  const pr=getExercisePR(select.value);

  summary.innerHTML=`

    <div class="grid2">

      <div class="stat">

        <div class="muted small">
          CURRENT BEST
        </div>

        <div class="stat-value">
          ${last.weight}kg
        </div>

        <div class="muted small">
          × ${last.reps} reps
        </div>

      </div>

      <div class="stat">

        <div class="muted small">
          CHANGE
        </div>

        <div class="stat-value ${
          change>0?"good":""
        }">
          ${change>0?"+":""}${round(change)}kg
        </div>

        <div class="muted small">
          since first entry
        </div>

      </div>

    </div>

    <div class="card" style="margin-top:11px">

      <div class="muted small">
        ESTIMATED 1RM
      </div>

      <div class="pr-number" style="margin-top:4px">
        ${round(pr.e1rm)}kg
      </div>

      <div class="muted small">
        Epley estimate based on your best logged set.
      </div>

    </div>

  `;

}

function drawChart(points){

  const canvas=
    document.getElementById("progressCanvas");

  const rect=
    canvas.getBoundingClientRect();

  const ratio=
    window.devicePixelRatio||1;

  canvas.width=rect.width*ratio;
  canvas.height=rect.height*ratio;

  const ctx=canvas.getContext("2d");

  ctx.setTransform(
    ratio,0,0,ratio,0,0
  );

  const width=rect.width;
  const height=rect.height;

  ctx.clearRect(
    0,0,width,height
  );

  if(!points.length){

    ctx.fillStyle="#707884";
    ctx.font="13px -apple-system";
    ctx.fillText(
      "No progress data yet",
      18,28
    );

    return;

  }

  const values=
    points.map(p=>p.weight);

  const max=Math.max(...values);
  const min=Math.min(...values);
  const range=Math.max(max-min,5);

  /* grid */

  ctx.strokeStyle="#20252d";
  ctx.lineWidth=1;

  for(let i=1;i<5;i++){

    const y=
      15+
      i*((height-30)/5);

    ctx.beginPath();
    ctx.moveTo(0,y);
    ctx.lineTo(width,y);
    ctx.stroke();

  }

  /* line */

  ctx.beginPath();

  points.forEach((point,i)=>{

    const x=
      points.length===1
      ?width/2
      :15+
        i*((width-30)/(points.length-1));

    const y=
      height-20-
      ((point.weight-min)/range)*
      (height-45);

    if(i===0) ctx.moveTo(x,y);
    else ctx.lineTo(x,y);

  });

  ctx.strokeStyle="#f4f4f4";
  ctx.lineWidth=3;
  ctx.lineJoin="round";
  ctx.lineCap="round";
  ctx.stroke();

  /* points */

  points.forEach((point,i)=>{

    const x=
      points.length===1
      ?width/2
      :15+
        i*((width-30)/(points.length-1));

    const y=
      height-20-
      ((point.weight-min)/range)*
      (height-45);

    ctx.beginPath();
    ctx.arc(x,y,4,0,Math.PI*2);

    ctx.fillStyle="#f4f4f4";
    ctx.fill();

  });

  /* current value */

  const latest=points[points.length-1];

  ctx.fillStyle="#9ba2ac";
  ctx.font="12px -apple-system";
  ctx.fillText(
    latest.weight+"kg",
    width-55,
    18
  );

}

function renderPRList(){

  const container=
    document.getElementById("prList");

  const prs=allPRs();

  container.innerHTML="";

  const entries=
    Object.entries(prs)
    .sort(
      (a,b)=>b[1].weight-a[1].weight
    );

  if(!entries.length){

    container.innerHTML=`

      <div class="empty">
        No personal records yet.
      </div>

    `;

    return;

  }

  entries.forEach(([name,pr])=>{

    const row=document.createElement("div");

    row.className="pr-row";

    row.innerHTML=`

      <div>
        <div class="pr-name">
          ${escapeHTML(name)}
        </div>

        <div class="muted small">
          Best set: ${pr.weight}kg × ${pr.reps}
        </div>
      </div>

      <div class="pr-value">
        ${round(pr.e1rm)}kg
        <div class="muted small">
          est. 1RM
        </div>
      </div>

    `;

    container.appendChild(row);

  });

}

/* =========================================================
   HISTORY
   ========================================================= */

function renderHistory(){

  document.getElementById("historySessions")
    .textContent=state.history.length;

  document.getElementById("historySets")
    .textContent=calculateTotalSets();

  const container=
    document.getElementById("historyList");

  container.innerHTML="";

  if(!state.history.length){

    container.innerHTML=`

      <div class="card empty">
        No completed workouts yet.
      </div>

    `;

    return;

  }

  [...state.history]
    .reverse()
    .forEach(workout=>{

      const card=document.createElement("div");

      card.className="card";

      const volume=
        calculateWorkoutVolume(workout);

      const sets=
        workout.exercises.reduce(
          (sum,ex)=>
            sum+
            ex.sets.filter(
              s=>s.weight!==""&&s.reps!==""
            ).length,
          0
        );

      card.innerHTML=`

        <div class="history-row">

          <div class="history-main">

            <div class="history-name">
              ${escapeHTML(workout.name)}
            </div>

            <div class="history-date">
              ${formatDate(workout.date)}
            </div>

          </div>

          <div style="text-align:right">

            <strong>
              ${volume}kg
            </strong>

            <div class="muted small">
              ${sets} sets
            </div>

          </div>

        </div>

      `;

      container.appendChild(card);

    });

}

/* =========================================================
   SETTINGS
   ========================================================= */

function renderSettings(){

  const container=
    document.getElementById("exerciseManager");

  container.innerHTML="";

  const select=
    document.getElementById("addWorkoutSelect");

  select.innerHTML="";

  Object.entries(state.workouts)
    .forEach(([workout,exercises])=>{

      const option=
        document.createElement("option");

      option.value=workout;
      option.textContent=workout;

      select.appendChild(option);

      const card=document.createElement("div");

      card.className="card";

      let html=
        `<h3>${escapeHTML(workout)}</h3>`;

      exercises.forEach((exercise,index)=>{

        html+=`

          <div class="settings-row">

            <span>
              ${escapeHTML(exercise)}
            </span>

            <button class="danger"
              onclick="deleteExercise('${escapeAttr(workout)}',${index})">
              Delete
            </button>

          </div>

        `;

      });

      card.innerHTML=html;

      container.appendChild(card);

    });

}

function addExercise(){

  const workout=
    document.getElementById("addWorkoutSelect")
    .value;

  const input=
    document.getElementById("addExerciseInput");

  const name=input.value.trim();

  if(!name){

    showToast("Enter an exercise name.");

    return;

  }

  if(
    state.workouts[workout]
      .some(
        e=>e.toLowerCase()===name.toLowerCase()
      )
  ){

    showToast("Exercise already exists.");

    return;

  }

  state.workouts[workout].push(name);

  input.value="";

  save();

  renderSettings();

  showToast("Exercise added.");

}

function deleteExercise(workout,index){

  if(
    !confirm(
      "Remove this exercise from the workout?"
    )
  ) return;

  state.workouts[workout]
    .splice(index,1);

  save();

  renderSettings();

}

/* =========================================================
   TIMER
   ========================================================= */

function startTimer(seconds){

  clearInterval(timerInterval);

  timerRemaining=seconds;

  updateTimer();

  const circle=
    document.getElementById("timerCircle");

  circle.classList.add("running");

  timerInterval=setInterval(()=>{

    timerRemaining--;

    updateTimer();

    if(timerRemaining<=0){

      clearInterval(timerInterval);

      circle.classList.remove("running");

      if(navigator.vibrate){

        navigator.vibrate(
          [180,100,180,100,250]
        );

      }

      showToast("Rest finished 🔔");

    }

  },1000);

}

function updateTimer(){

  document.getElementById("timerNumber")
    .textContent=
      timerRemaining;

}

function stopTimer(){

  clearInterval(timerInterval);

  document.getElementById("timerCircle")
    .classList.remove("running");

  timerRemaining=90;

  updateTimer();

}

/* =========================================================
   COMPLETE / EXIT WORKOUT
   ========================================================= */

function completeWorkout(){

  if(!state.current) return;

  let logged=0;

  state.current.exercises.forEach(ex=>{

    ex.sets.forEach(set=>{

      if(
        set.weight!=="" &&
        set.reps!==""
      ) logged++;

    });

  });

  if(!logged){

    showToast("Log at least one set first.");

    return;

  }

  const beforePRs=
    JSON.parse(
      JSON.stringify(allPRs())
    );

  const workout={
    id:state.current.id,
    name:state.current.name,
    started:state.current.started,
    date:new Date().toISOString(),
    exercises:state.current.exercises
  };

  state.history.push(workout);

  state.current=null;

  save();

  stopTimer();

  const afterPRs=allPRs();

  let newPR=false;

  Object.keys(afterPRs).forEach(name=>{

    const before=beforePRs[name];
    const after=afterPRs[name];

    if(
      after &&
      (
        !before ||
        after.weight>before.weight ||
        after.reps>before.reps
      )
    ){

      newPR=true;

    }

  });

  showScreen("dashboard");

  if(newPR){

    showToast("New PR! 🏆");

  }else{

    showToast("Workout complete! 💪");

  }

}

function exitWorkout(){

  if(
    !confirm(
      "Exit this workout? Your current session will be kept so you can resume it."
    )
  ) return;

  save();

  showScreen("dashboard");

}

/* =========================================================
   BACKUP
   ========================================================= */

function exportBackup(){

  const blob=new Blob(
    [
      JSON.stringify(
        state,
        null,
        2
      )
    ],
    {
      type:"application/json"
    }
  );

  const url=
    URL.createObjectURL(blob);

  const a=
    document.createElement("a");

  a.href=url;
  a.download=
    "workout-tracker-v3-backup.json";

  document.body.appendChild(a);

  a.click();

  a.remove();

  URL.revokeObjectURL(url);

  showToast("Backup exported.");

}

function importBackup(event){

  const file=
    event.target.files[0];

  if(!file) return;

  const reader=new FileReader();

  reader.onload=function(){

    try{

      const imported=
        JSON.parse(reader.result);

      if(
        !imported.workouts ||
        !imported.history
      ){

        throw new Error();

      }

      state={
        workouts:imported.workouts,
        history:imported.history,
        current:imported.current||null
      };

      save();

      showToast("Backup restored.");

      setTimeout(
        ()=>location.reload(),
        600
      );

    }catch(e){

      alert(
        "That backup file could not be loaded."
      );

    }

  };

  reader.readAsText(file);

}

function resetAll(){

  if(
    !confirm(
      "This will delete ALL workouts, progress, PRs and history. This cannot be undone unless you have a backup."
    )
  ) return;

  localStorage.removeItem(
    "WORKOUT_TRACKER_V3"
  );

  location.reload();

}

/* =========================================================
   HELPERS
   ========================================================= */

function allExercises(){

  const result=[];

  Object.values(state.workouts)
    .forEach(exercises=>{

      exercises.forEach(exercise=>{

        if(!result.includes(exercise))
          result.push(exercise);

      });

    });

  return result;

}

function round(number){

  return Math.round(number*10)/10;

}

function escapeHTML(value){

  return String(value)
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");

}

function escapeAttr(value){

  return String(value)
    .replace(/\\/g,"\\\\")
    .replace(/'/g,"\\'");

}

/* =========================================================
   INITIALISE
   ========================================================= */

window.addEventListener(
  "resize",
  ()=>{
    if(
      document
        .getElementById("progress")
        .classList.contains("active")
    ){
      drawProgress();
    }
  }
);

renderDashboard();

</script>

</body>
</html>
